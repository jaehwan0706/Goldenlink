# ──────────────────────────────────────────────────────────────
# 5MIN 환경변수 설정 파일
# .env.example 복사해서 .env 로 저장 후 값 채우기
# .env 는 절대 깃에 올리면 안됨!
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# ┌─────────────────────────────────────────────────────────────
# │ 1. DB 접속 정보
# │    AWS RDS 만들고 나서 채우는 값
# └─────────────────────────────────────────────────────────────
DB_HOST=여기에_RDS_엔드포인트_붙여넣기
# 예시) fivemin-mysql.abc123.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=fivemin_app
DB_PASSWORD=RDS_만들때_설정한_비밀번호
DB_NAME=fivemin
DB_POOL_LIMIT=20

# ┌─────────────────────────────────────────────────────────────
# │ 2. JWT 시크릿  (아무 랜덤 문자열이면 됨)
# │    터미널에서 생성:
# │    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# └─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=여기에_랜덤문자열_붙여넣기_1
JWT_REFRESH_SECRET=여기에_랜덤문자열_붙여넣기_2
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# ┌─────────────────────────────────────────────────────────────
# │ 3. Medical ID 암호화 키  (아무 랜덤 문자열이면 됨)
# │    터미널에서 생성:
# │    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# └─────────────────────────────────────────────────────────────
MEDICAL_ID_ENCRYPTION_KEY=여기에_랜덤문자열_붙여넣기_3

# ┌─────────────────────────────────────────────────────────────
# │ 4. 포트원 PASS 본인인증
# │
# │    포트원 콘솔(portone.io) 에서 찾는 곳:
# │
# │    PORTONE_IMP_UID
# │      → 콘솔 왼쪽 상단 이메일 클릭
# │        → [상점·계정 관리] → [내 식별코드] 탭
# │        → imp_00000000 형태 값
# │
# │    PORTONE_IMP_KEY / PORTONE_IMP_SECRET
# │      → 콘솔 왼쪽 상단 이메일 클릭
# │        → [상점·계정 관리] → [API Keys] 탭
# │        → [REST API Key] / [REST API Secret] 값
# └─────────────────────────────────────────────────────────────

# ┌─────────────────────────────────────────────────────────────
# │ 5. 보건복지부 응급의료 오픈 API
# │    https://www.data.go.kr 에서 신청 (무료)
# └─────────────────────────────────────────────────────────────
EMERGENCY_API_KEY=여기에_오픈API_키_붙여넣기
EMERGENCY_API_URL=https://apis.data.go.kr/B552657/ErmctInfoInqireService
